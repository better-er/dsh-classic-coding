{
  "name": "dsh-classic-coding",
  "version": "0.3.0",
  "description": "「DSH·古法编程」：在 DSH Web UI 内置文件预览里切换修改模式，直接编辑并保存工作区文本",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "coding",
    "file-preview",
    "editor"
  ],
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=26.3.1"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "assets/"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node smoke/verify.mjs && node smoke/editing.mjs",
    "smoke": "node smoke/verify.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "happy-dom": "^21.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-er/dsh-classic-coding.git"
  },
  "license": "MIT"
}
